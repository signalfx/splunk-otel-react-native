{
  "name": "@splunk/otel-session-replay-react-native",
  "version": "1.0.0-alpha.1",
  "description": "Splunk Session Replay for React Native",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "react-native": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**",
    "lib/**",
    "android/build.gradle",
    "android/gradle.properties",
    "android/src/**",
    "ios/**/*.{h,m,mm,swift}",
    "*.podspec",
    "LICENSE",
    "README.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "node --experimental-require-module ./node_modules/react-native-builder-bob/bin/bob build",
    "build": "node --experimental-require-module ./node_modules/react-native-builder-bob/bin/bob build",
    "prepublishOnly": "yarn typecheck",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build ios/build lib"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "session-replay",
    "splunk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalfx/splunk-otel-react-native.git"
  },
  "author": "Splunk Observability MRUM Team",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/signalfx/splunk-otel-react-native/issues"
  },
  "homepage": "https://github.com/signalfx/splunk-otel-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.81.1",
    "@splunk/otel-react-native": "workspace:*",
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-builder-bob": "^0.40.17",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@splunk/otel-react-native": ">=1.0.0-alpha.1",
    "react": ">=18.2.0",
    "react-native": ">=0.75.0 <1.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SplunkSessionReplaySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.splunk.otel.reactnative.sessionreplay"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.54.5"
  }
}
