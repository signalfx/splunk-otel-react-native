{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml",
    "example/Gemfile.lock",
    "example/ios/Podfile.lock",
    "example/android/app/gradle.lockfile",
    "example/android/settings-gradle.lockfile",
    "packages/*/android/gradle.lockfile",
    "packages/core/ios/frameworks/manifest.json"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": ["lib/**", "plugin/build/**"]
    },
    "build:android": {
      "dependsOn": ["build"],
      "env": ["ANDROID_HOME", "JAVA_OPTS"],
      "inputs": [
        "package.json",
        "android/**",
        "!android/build/**",
        "src/**/*.ts",
        "src/**/*.tsx",
        "example/package.json",
        "example/android/**",
        "!example/android/.gradle/**",
        "!example/android/build/**",
        "!example/android/app/build/**"
      ],
      "outputs": ["example/android/app/build/outputs/**"]
    },
    "build:ios": {
      "dependsOn": ["build"],
      "env": ["RCT_USE_RN_DEP", "RCT_USE_PREBUILT_RNCORE"],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios/**",
        "!ios/build/**",
        "src/**/*.ts",
        "src/**/*.tsx",
        "example/package.json",
        "example/ios/**",
        "!example/ios/build/**",
        "!example/ios/Pods/**"
      ],
      "outputs": ["example/ios/build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/__tests__/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "eslint.config.mjs"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig*.json"],
      "outputs": []
    }
  }
}
