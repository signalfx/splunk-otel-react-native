{
  "name": "splunk-otel-react-native-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Splunk distribution of Open Telemetry for React Native",
  "scripts": {
    "example": "yarn workspace splunk-otel-react-native-example",
    "start": "yarn workspace splunk-otel-react-native-example start",
    "ios": "yarn workspace splunk-otel-react-native-example ios",
    "android": "yarn workspace splunk-otel-react-native-example android",
    "build:android": "yarn workspace splunk-otel-react-native-example build:android",
    "build:ios": "yarn workspace splunk-otel-react-native-example build:ios",
    "reset": "yarn workspace splunk-otel-react-native-example start --reset-cache",
    "build": "yarn workspace @splunk/otel-react-native build && yarn workspace @splunk/otel-session-replay-react-native build",
    "prepare": "yarn workspace @splunk/otel-react-native build && yarn workspace @splunk/otel-session-replay-react-native build",
    "clean": "del-cli example/android/build example/android/app/build example/ios/build packages/core/lib packages/session-replay/lib",
    "clean:all": "del-cli example/android/build example/android/app/build example/android/.gradle example/ios/build example/ios/Pods packages/core/android/build packages/core/ios/build packages/core/lib packages/session-replay/android/build packages/session-replay/ios/build packages/session-replay/lib",
    "arch:new": "./scripts/set-arch.sh new",
    "arch:old": "./scripts/set-arch.sh old",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "typecheck": "yarn workspace @splunk/otel-react-native typecheck && yarn workspace @splunk/otel-session-replay-react-native typecheck",
    "test": "yarn workspace @splunk/otel-react-native test && yarn workspace @splunk/otel-session-replay-react-native test",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalfx/splunk-otel-react-native.git"
  },
  "author": "Splunk Observability MRUM Team",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/signalfx/splunk-otel-react-native/issues"
  },
  "homepage": "https://github.com/signalfx/splunk-otel-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/compat": "1.4.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@evilmartians/lefthook": "1.13.6",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.4",
    "@release-it/conventional-changelog": "10.0.1",
    "commitlint": "19.8.1",
    "del-cli": "6.0.0",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.6.2",
    "release-it": "19.0.5",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "example",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.1.0",
    "react-native": "0.81.1",
    "js-yaml": "4.1.1",
    "tar@npm:^7.4.3": "7.5.4",
    "glob@npm:^10.2.2": "10.5.0",
    "glob@npm:^10.4.2": "10.5.0",
    "glob@npm:^10.5.0": "10.5.0",
    "qs@npm:6.13.0": "6.14.1"
  },
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">=22"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
