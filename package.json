{
  "name": "splunk-otel-react-native-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Splunk distribution of Open Telemetry for React Native",
  "scripts": {
    "example": "yarn workspace splunk-otel-react-native-example",
    "start": "yarn workspace splunk-otel-react-native-example start",
    "ios": "yarn workspace splunk-otel-react-native-example ios",
    "android": "yarn workspace splunk-otel-react-native-example android",
    "build:android": "yarn workspace splunk-otel-react-native-example build:android",
    "build:ios": "yarn workspace splunk-otel-react-native-example build:ios",
    "reset": "yarn workspace splunk-otel-react-native-example start --reset-cache",
    "build": "yarn workspace @splunk/otel-react-native build && yarn workspace @splunk/otel-session-replay-react-native build",
    "prepare": "yarn workspace @splunk/otel-react-native build && yarn workspace @splunk/otel-session-replay-react-native build",
    "clean": "del-cli example/android/build example/android/app/build example/ios/build packages/core/lib packages/session-replay/lib",
    "clean:all": "del-cli example/android/build example/android/app/build example/android/.gradle example/ios/build example/ios/Pods packages/core/android/build packages/core/ios/build packages/core/lib packages/session-replay/android/build packages/session-replay/ios/build packages/session-replay/lib",
    "write:framework-integrity": "node scripts/framework-integrity.mjs --write",
    "check:framework-integrity": "node scripts/framework-integrity.mjs --check",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "check:install-artifacts": "node scripts/check-install-artifacts.mjs",
    "audit:dependencies": "yarn npm audit --all --recursive --severity high",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "typecheck": "yarn workspace @splunk/otel-react-native typecheck && yarn workspace @splunk/otel-session-replay-react-native typecheck",
    "test": "yarn workspace @splunk/otel-react-native test && yarn workspace @splunk/otel-session-replay-react-native test",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalfx/splunk-otel-react-native.git"
  },
  "author": "Splunk Observability MRUM Team",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/signalfx/splunk-otel-react-native/issues"
  },
  "homepage": "https://github.com/signalfx/splunk-otel-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/compat": "1.4.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@evilmartians/lefthook": "1.13.6",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@release-it/conventional-changelog": "10.0.6",
    "commitlint": "19.8.1",
    "del-cli": "6.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "release-it": "19.2.4",
    "turbo": "2.10.10",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "example",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.2.3",
    "react-native": "0.86.2",
    "@babel/core": "7.29.7",
    "@xmldom/xmldom@npm:^0.8.8": "0.8.15",
    "ajv@npm:^8.11.0": "8.18.0",
    "basic-ftp@npm:^5.0.2": "5.3.1",
    "body-parser@npm:^1.20.3": "1.20.6",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "defu@npm:^6.1.4": "6.1.7",
    "fast-uri@npm:^3.0.1": "3.1.5",
    "flatted@npm:^3.2.9": "3.4.4",
    "handlebars@npm:^4.7.7": "4.7.9",
    "ip-address@npm:^10.0.1": "10.4.0",
    "joi": "17.13.4",
    "launch-editor@npm:^2.9.1": "2.14.1",
    "lodash@npm:^4.15.0": "4.18.1",
    "lodash@npm:^4.17.21": "4.18.1",
    "minimatch@npm:^3.0.4": "3.1.5",
    "minimatch@npm:^3.0.5": "3.1.5",
    "minimatch@npm:^3.1.1": "3.1.5",
    "minimatch@npm:^3.1.2": "3.1.5",
    "minimatch@npm:^3.1.5": "3.1.5",
    "minimatch@npm:^9.0.4": "9.0.9",
    "nanoid@npm:^3.3.11": "3.3.18",
    "picomatch@npm:^2.0.4": "2.3.2",
    "picomatch@npm:^2.2.3": "2.3.2",
    "picomatch@npm:^2.3.1": "2.3.2",
    "picomatch@npm:^4.0.3": "4.0.5",
    "picomatch@npm:^4.0.4": "4.0.5",
    "shell-quote@npm:^1.6.1": "1.10.0",
    "shell-quote@npm:^1.8.3": "1.10.0",
    "undici@npm:6.23.0": "6.28.0",
    "ws@npm:^6.2.3": "6.2.6",
    "ws@npm:^7": "7.5.13",
    "ws@npm:^7.5.10": "7.5.13",
    "yaml": "2.8.3"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
